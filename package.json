{
  "name": "protopath-mcp",
  "version": "0.3.0",
  "description": "Infer wire protocol structure from a pcap or pcapng capture: framing, fields, counters, checksums. MCP server, Wireshark dissector, TypeScript and Python clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "protopath": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "captures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reverse-engineering",
    "protocol",
    "protocol-analysis",
    "pcap",
    "pcapng",
    "wireshark",
    "network",
    "agent",
    "claude",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fa33az/protopath.git"
  },
  "homepage": "https://github.com/fa33az/protopath#readme",
  "bugs": {
    "url": "https://github.com/fa33az/protopath/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.tests.json",
    "captures": "npm run build:test && node dist-test/scripts/make-captures.js",
    "bench:corpus": "npm run build:test && node dist-test/bench/make-bench.js",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "test": "npm run build:test && node scripts/run-tests.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "cli": "node dist/cli/index.js",
    "prepublishOnly": "npm run build && npm run check:docs && npm test",
    "profile": "npm run build:test && node scripts/profile.mjs",
    "bench:proprietary:corpus": "npm run build:test && node dist-test/bench/proprietary/make-proprietary.js",
    "bench:proprietary": "npm run build && node scripts/proprietary-bench.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
